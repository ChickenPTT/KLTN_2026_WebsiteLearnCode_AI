# ---------------------------------------------------------------------------
# Backend Spring Boot
# ---------------------------------------------------------------------------
# Để trống -> gọi qua đường dẫn tương đối /api, Vite proxy sang localhost:8080
# (xem server.proxy trong vite.config.ts). Chỉ set khi deploy FE/BE khác origin.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Chế độ đăng nhập
#   auto (mặc định) — gọi /api/auth/* ; nếu backend chưa chạy thì tự dùng tài khoản mock
#   api             — chỉ dùng backend
#   mock            — chỉ dùng tài khoản demo trong src/data/mockAuth.ts
# ---------------------------------------------------------------------------
VITE_AUTH_MODE=auto
