# ---------------------------------------------------------------------------
# Backend Spring Boot
# ---------------------------------------------------------------------------
# Để trống -> gọi qua đường dẫn tương đối /api, Vite proxy sang localhost:8080
# (xem server.proxy trong vite.config.ts). Chỉ set khi deploy FE/BE khác origin.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Supabase config (chỉ dùng nếu chọn auth bằng Supabase thay vì Spring Boot)
# Lấy từ: https://app.supabase.com → Project Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Khi VITE_SUPABASE_URL còn trống, ứng dụng chạy ở MOCK MODE
# (dùng tài khoản demo trong src/data/mockAuth.ts)
