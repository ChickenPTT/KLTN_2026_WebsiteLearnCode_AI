# Judge0 API Configuration
JUDGE0_API_KEY=your_judge0_api_key_here

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (AI du phong)
GROD_API_KEY=your_groq_api_key_here

# Database Configuration
DB_PASSWORD=your_database_password_here

# Dang nhap bang Google - Client ID (cong khai). KHONG can Client Secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Xac nhan email khi dang ky (Brevo -> API key dang xkeysib-..., KHONG phai SMTP key)
# De trong BREVO_API_KEY = tat xac nhan, dang ky khong can ma
BREVO_API_KEY=
MAIL_FROM=gmail_nguoi_gui_da_xac_minh_tren_brevo@gmail.com

# ---- Chi can khi deploy bang docker-compose ----
# Chuoi ngau nhien >= 32 ky tu (vd: openssl rand -base64 48)
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# true khi da co HTTPS (SITE_ADDRESS la ten mien); false khi chay thu bang HTTP
JWT_COOKIE_SECURE=false
# De trong = chay HTTP cong 80. Dien ten mien de Caddy tu lay HTTPS,
# vd: SITE_ADDRESS=kltn-ten-ban.southeastasia.cloudapp.azure.com
SITE_ADDRESS=


